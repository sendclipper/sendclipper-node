{
  "name": "@sendclipper/node",
  "version": "0.1.0",
  "description": "Official Node.js SDK for the SendClipper email API: send mail, manage domains, templates, sandboxes, webhooks, contacts and suppressions.",
  "license": "MIT",
  "author": "SendClipper <support@sendclipper.com>",
  "homepage": "https://sendclipper.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sendclipper/sendclipper-node.git"
  },
  "bugs": {
    "url": "https://github.com/sendclipper/sendclipper-node/issues"
  },
  "keywords": [
    "sendclipper",
    "email",
    "transactional-email",
    "smtp",
    "webhooks",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/fix-cjs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:dist": "node --test test/dist/*.test.mjs test/dist/*.test.cjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run test:dist",
    "test:live": "node --test --test-concurrency=1 test/live/*.test.mjs"
  },
  "peerDependencies": {
    "@react-email/render": "*"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
